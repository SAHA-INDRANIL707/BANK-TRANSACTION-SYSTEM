# ============================================================
#  ROOT MONOREPO .gitignore
#  Covers: Bank-Backend (Node/Express) + Bank-Frontend (Next.js)
# ============================================================

# ──────────────────────────────────────────────
# 1. SENSITIVE / SECRET FILES  ← NEVER commit these
# ──────────────────────────────────────────────
.env
.env.*
!.env.example          # allow the example template only
*.pem
*.key
*.p12
*.pfx
*.cert
*.crt
secrets/
credentials/

# ──────────────────────────────────────────────
# 2. NODE MODULES  ← Always regenerated by npm install
# ──────────────────────────────────────────────
**/node_modules/
node_modules/

# ──────────────────────────────────────────────
# 3. NEXT.JS BUILD OUTPUT
# ──────────────────────────────────────────────
**/.next/
**/out/
**/build/
**/.vercel/

# ──────────────────────────────────────────────
# 4. TYPESCRIPT ARTIFACTS
# ──────────────────────────────────────────────
**/*.tsbuildinfo
**/next-env.d.ts

# ──────────────────────────────────────────────
# 5. LOGS & DEBUG FILES
# ──────────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
logs/
*.log.*

# ──────────────────────────────────────────────
# 6. OS / EDITOR GENERATED FILES
# ──────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
.vscode/settings.json
.vscode/launch.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ──────────────────────────────────────────────
# 7. TESTING & COVERAGE
# ──────────────────────────────────────────────
**/coverage/
**/.nyc_output/
**/jest-results/

# ──────────────────────────────────────────────
# 8. YARN / PNPM / BUN
# ──────────────────────────────────────────────
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions
.pnp.*
.pnp.js

# ──────────────────────────────────────────────
# 9. MISC
# ──────────────────────────────────────────────
*.pid
*.seed
*.pid.lock
.cache/
tmp/
temp/
dist/
